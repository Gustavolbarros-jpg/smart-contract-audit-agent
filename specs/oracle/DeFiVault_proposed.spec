// identity_gate: removeFromWhitelist is gated on msg.sender == owner; removing the gate must make it revert for anyone else
rule only_owner_calls_removeFromWhitelist(address user) {
    env e;
    require e.msg.sender != owner();

    removeFromWhitelist@withrevert(e, user);

    assert lastReverted, "removeFromWhitelist went through for a caller that is not owner";
}

// credit: deposit credits balances[msg.sender] from a nonzero amount; a credit that can round to nothing leaves value in the contract with no claim on it
rule deposit_never_credits_zero() {
    env e;
    require e.msg.value > 0;

    uint256 antes = balances(e.msg.sender);
    deposit(e);
    uint256 depois = balances(e.msg.sender);

    assert depois > antes, "a nonzero e.msg.value left the caller's balances untouched";
}

// credit_total: deposit moves balances[msg.sender] and totalDeposits together; they must move by the same amount
rule deposit_credits_totalDeposits_by_the_same_amount() {
    env e;

    uint256 antes_conta = balances(e.msg.sender);
    uint256 antes_total = totalDeposits();
    deposit(e);
    uint256 depois_conta = balances(e.msg.sender);
    uint256 depois_total = totalDeposits();

    assert to_mathint(depois_total) - to_mathint(antes_total)
        == to_mathint(depois_conta) - to_mathint(antes_conta),
        "totalDeposits and balances[msg.sender] moved by different amounts";
}

// debit: withdraw debits balances[msg.sender] by amount; any other delta is an accounting error
rule withdraw_debits_exactly(uint256 amount) {
    env e;

    uint256 antes = balances(e.msg.sender);
    withdraw(e, amount);
    uint256 depois = balances(e.msg.sender);

    assert to_mathint(depois) == to_mathint(antes) - amount,
        "balances[msg.sender] did not fall by exactly amount";
}

// debit_total: withdraw debits totalDeposits alongside the caller's balance; both must fall by amount
rule withdraw_debits_totalDeposits_by_the_same_amount(uint256 amount) {
    env e;

    uint256 antes = totalDeposits();
    withdraw(e, amount);
    uint256 depois = totalDeposits();

    assert to_mathint(depois) == to_mathint(antes) - amount,
        "totalDeposits did not fall by exactly amount";
}

